APP_NAME=Laravel
# Dev default: JANGAN ubah ke production di sini. Di produksi WAJIB set
# APP_ENV=production dan APP_DEBUG=false via env deployment (APP_DEBUG=true
# membocorkan stack trace/SQL ke respons API — lihat Backend/AGENTS.md).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kelolagudang
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Password akun seed (dibaca `UserSeeder`). WAJIB diisi — tanpa nilai, seeder menolak jalan.
# Jangan simpan nilai password di repo; cukup set di file `.env` lokal.
DEMO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Frontend origin(s) allowed by CORS (`config/cors.php`). Auth is bearer-token based
# (no cookie credentials), so origins only matter for the rare direct cross-origin call;
# the Vercel build talks same-origin through its /api rewrite.
FRONTEND_URL=http://localhost:8080,https://kelola-gudang-hexa.vercel.app

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI Assistant (F8). Default MATI (AI_ENABLED=false) — tak ada panggilan
# keluar sampai admin mengaktifkan. Provider kini: groq (OpenAI-compatible).
# JANGAN commit nilai key; isi hanya di .env lokal (file ini hanya placeholder).
AI_ENABLED=false
# Provider: groq | 9router | openai_compatible | ollama | null
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
AI_DAILY_QUOTA=100
AI_TIMEOUT=60
AI_MAX_TOKENS=1024
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# 9Router (gateway lokal OpenAI-compatible). Aktifkan dgn AI_PROVIDER=9router.
# Jalankan 9Router lokal (docker, port default 20128). Pakai 127.0.0.1 (bukan
# localhost) agar tidak kena isu IPv6. Model bisa cc/claude-*, gemini, dll.
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
# Provider custom OpenAI-compatible (AI_PROVIDER=openai_compatible) — OpenRouter/vLLM.
AI_API_KEY=
AI_BASE_URL=
# Ollama lokal (AI_PROVIDER=ollama) — tanpa key.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Text-to-SQL read-only (F8.5). Set user PG SELECT-only `ai_reader` di produksi
# (pertahanan DB-level; tanpa ini jatuh ke kredensial default — tak disarankan).
# Buat role-nya: `php artisan ai:setup-reader` (sebagai superuser/pemilik DB).
AI_DB_USERNAME=
AI_DB_PASSWORD=
AI_SQL_TIMEOUT_MS=10000
# Fail-closed produksi: true = analisis_data menolak jalan kecuali ai_readonly
# memakai user DB khusus. Default false (dev/test frictionless); WAJIB true prod.
AI_ENFORCE_READER=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
