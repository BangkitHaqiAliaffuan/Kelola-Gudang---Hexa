<mxfile host="app.diagrams.net">
  <diagram name="Laporan Audit" id="laporan-audit">
    <mxGraphModel dx="1664" dy="238" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% =====================================================================\n%% ERD 06 — Konteks Antar-Modul + Tabel System (Optimized Layout)\n%% KelolaGudang.\n%% =====================================================================\nerDiagram\n    %% 1. Relasi dari User Role (Aktor Utama) diletakkan pertama agar berada di puncak\n    mod_user_role ||--o{ settings : \&quot;pengubah\&quot;\n    mod_user_role ||--o{ mod_pengadaan : \&quot;requester/approver\&quot;\n    mod_user_role ||--o{ mod_dokumen : \&quot;requester/approver/pencatat\&quot;\n\n    %% 2. Relasi dari Master Data (Referensi)\n    %% Relasi ganda digabung menjadi satu baris agar tidak ada garis ganda yang bertabrakan\n    mod_master ||--o{ mod_pengadaan : \&quot;barang pada baris &amp; dept pemohon\&quot;\n    mod_master ||--o{ mod_dokumen : \&quot;barang, lokasi &amp; tujuan\&quot;\n    mod_master ||--o{ mod_ledger : \&quot;stok per item &amp; lokasi gudang\&quot;\n\n    %% 3. Relasi Antar Modul Transaksi &amp; Pencatatan (Flow Proses)\n    mod_pengadaan ||--o{ mod_dokumen : \&quot;penerimaan ref nomor PO\&quot;\n    mod_dokumen ||--o{ mod_ledger : \&quot;posting ke movement\&quot;\n\n    %% 4. Relasi ke Audit Logs (Tersentralisasi)\n    %% Dideklarasikan terakhir agar mesin layout menempatkannya di bagian bawah/pinggir\n    mod_user_role ||--o{ audit_logs : \&quot;tercatat\&quot;\n    mod_master ||--o{ audit_logs : \&quot;tercatat (polimorfik)\&quot;\n    mod_pengadaan ||--o{ audit_logs : \&quot;tercatat (polimorfik)\&quot;\n    mod_dokumen ||--o{ audit_logs : \&quot;tercatat (polimorfik)\&quot;\n\n    %% Struktur Entitas\n    mod_master {\n        string modul\n        string kunci\n    }\n    mod_user_role {\n        string modul\n        string kunci\n    }\n    mod_ledger {\n        string modul\n        string kunci\n    }\n    mod_dokumen {\n        string modul\n        string kunci\n    }\n    mod_pengadaan {\n        string modul\n        string kunci\n    }\n    audit_logs {\n        int id PK\n        timestamp occurred_at\n        int user_id FK\n        string action\n        string module\n        string record_no\n    }\n    settings {\n        int id PK\n        string key UK\n        json value\n        int updated_by_user_id FK\n    }\n    document_counters {\n        string scope PK\n        string counter_key PK\n        int current_number\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZZvr86tpy2mwgJ6cm_li-1749">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
