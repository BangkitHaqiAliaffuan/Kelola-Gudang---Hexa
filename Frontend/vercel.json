{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://plastic-unwanted-mashing.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://plastic-unwanted-mashing.ngrok-free.dev/sanctum/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  // Catatan CSP (W5.1): JANGAN tambah header Content-Security-Policy statis
  // di sini. HTML SSR diserve oleh server function (src/server.ts) yang
  // memasang CSP dinamis + nonce per-request; dua header CSP (statis +
  // dinamis) ditegakkan keduanya oleh browser sehingga nonce sia-sia.
  // Header hardening lain di bawah tetap berlaku untuk semua respons.
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
